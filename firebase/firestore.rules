rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════════════
    // F04 — REWRITE, 29 Jul 2026
    //
    // Three defects fixed here:
    //   (a) NO rules existed for orders / salesRecords / transactions /
    //       paymentJobs / auditTrail, so the catch-all denied every commerce
    //       write and nothing could ever record a sale.
    //   (b) `templates` had `allow create: if request.auth != null` — no field
    //       validation at all. A seller could create their own doc with
    //       status:'approved' already set; the approval function sees it is
    //       already approved and steps aside. The gate was on the wrong door.
    //   (c) `templates_internal` was read/write for ANY signed-in user, so every
    //       seller could read every other seller's private submission data.
    //
    // KEY DESIGN NOTE — read this before "fixing" the finance rules again:
    // Client browsers must NEVER write finance documents. If a browser can
    // write `orders`, a buyer can write their own order saying they paid.
    // Every finance write is done SERVER-SIDE by a Cloud Function using the
    // Admin SDK, which bypasses these rules entirely. So `allow write: if false`
    // on those collections is CORRECT, not an oversight — the browser's job is
    // only to READ its own records. This is why F04 alone does not make sales
    // work: it needs the Whop webhook (F06) to do the writing.
    // ════════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    // The two owner accounts. Same pair as TRUSTED_UIDS in functions/main.py
    // and the admin list in navbar.js — keep all three in sync.
    function isAdmin() {
      return isSignedIn() && request.auth.uid in [
        'EUgr3ahFHTdOtNL5oGyLPfQcX8A3',    // javed5395@gmail.com — site owner
        'FvcmbFk2AsXCIq1L2uog7t5erfp1'     // lazydogtemplates@gmail.com — business
      ];
    }

    // True when the signed-in user owns the document being read.
    function ownsDoc(field) {
      return isSignedIn() && resource.data[field] == request.auth.uid;
    }

    // ── CONTRIBUTOR GATE (6 Aug 2026) ─────────────────────────────────────
    // True only when this user has an application we have APPROVED.
    //
    // This is the real gate for the freelancer program. Hiding the upload
    // button in upload_form.html is presentation only — anyone can open the
    // console and write to Firestore directly. This function is what actually
    // stops them, because it is evaluated by Firestore on the server.
    //
    // get() costs one document read per write attempt. That is the correct
    // trade: uploads are rare, and letting an unapproved stranger publish to
    // the store would be far more expensive than a lookup.
    function isApprovedContributor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/contributor_applications/$(request.auth.uid))
        && get(/databases/$(database)/documents/contributor_applications/$(request.auth.uid)).data.status == 'approved';
    }

    // Who may submit a kit at all: us, or a freelancer we have approved.
    function mayUpload() {
      return isAdmin() || isApprovedContributor();
    }

    // ── kits collection (PRIVATE — 28 Jul 2026) ───────────────────────────
    // This holds `encoded_raw`: every metadata CODE for every kit. It was
    // `allow read: if true`, so anyone could open the collection in a browser
    // and harvest the whole codebook by comparing kits.
    //
    // Nothing on the site needs it. The search card does NOT read kits — it
    // posts the buyer's requirements to recommend_http, which scores against
    // encoded_raw SERVER-SIDE with the Admin SDK (Admin SDK ignores these
    // rules, so the function keeps working). Display data comes from
    // `templates`, which stays public.
    match /kits/{kitId} {
      allow read:  if false;        // browser must never see the codes
      allow write: if false;        // only Firebase Functions, via Admin SDK
      // Admin cascade delete (29 Jul 2026). Read/create/update stay locked —
      // this ONLY lets the two admin UIDs remove the leftover record when a kit
      // is deleted forever from the admin panel.
      allow delete: if isAdmin();
    }

    // ── templates collection (PUBLIC READ) ───────────────────────────────
    // Decoded plain-field documents read by search_widget.js.
    match /templates/{kitId} {
      allow read: if true;

      // CREATE is now field-validated. A seller may only submit something that
      // is genuinely pending and genuinely theirs. Field names match what
      // upload_form.html writes (status/sellerId/uploaderUid, ~line 1628).
      // The server (on_seller_submission) owns the transition to 'approved';
      // a client can no longer hand itself that value.
      // 6 Aug 2026 — now also requires mayUpload(). Before the freelancer
      // program, "any signed-in user" was effectively "the two of us". Once
      // strangers can create accounts on the site that is no longer true, so
      // submission is restricted to admins and APPROVED contributors.
      allow create: if mayUpload()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.sellerId    == request.auth.uid
                    && request.resource.data.uploaderUid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // ── templates_files collection (PRIVATE — F10, 29 Jul 2026) ───────────
    // Everything that used to sit in the world-readable `templates` doc and
    // should never have been there: the paid file URLs (pptx/pdf/key/designDoc),
    // the internal Cloudinary + Drive ids, and the seller's email and phone.
    //
    // NO client may read this. Buyers get a download URL from the
    // download_url_http function, which checks entitlement server-side with the
    // Admin SDK (Admin SDK ignores these rules). Admins may read it directly so
    // the admin panel can still find the file ids it needs to delete an asset.
    //
    // A seller may CREATE their own doc (upload_form.html writes it during
    // submission) but may never read one back — not even their own — because
    // read access here is the whole exposure we are closing.
    match /templates_files/{kitId} {
      allow read:   if isAdmin();
      // Gated the same way as templates/ — the two are written together during
      // submission, so leaving this one open would let an unapproved user
      // create orphan file records.
      allow create: if mayUpload() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── contributor_applications (FREELANCER PROGRAM — 6 Aug 2026) ───────
    // A designer applies here; an admin approves; only then may they upload.
    //
    // Doc id IS the applicant's uid. That single choice does most of the
    // security work: a signed-in user can only ever touch the document whose
    // id equals their own uid, so nobody can read, edit or create somebody
    // else's application.
    //
    // THE CRITICAL RULE is that `status` must be 'pending' on create, and a
    // non-admin may only keep it 'pending' on update. Without that, an
    // applicant could simply write status:'approved' from the browser console
    // and let themselves in.
    //
    // Editing is allowed while pending (fix a portfolio link, add a category)
    // but stops the moment a decision is made — an approved contributor must
    // not be able to quietly rewrite the terms they agreed to, and a rejected
    // one must not be able to reopen their own case.
    match /contributor_applications/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // request.auth.token.email_verified is checked server-side by Firebase
      // itself, so an unverified address cannot apply even if someone skips
      // the UI and writes to Firestore directly.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.agreedTerms == true
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 1
                    && request.resource.data.portfolio is string
                    && request.resource.data.portfolio.size() > 3
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() > 4;

      allow update: if isAdmin()
                    || (isSignedIn()
                        && request.auth.uid == uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ── downloads (DELIVERY RECORD — 6 Aug 2026) ─────────────────────────
    // Written ONLY by download_url_http (Admin SDK, bypasses these rules) the
    // moment a buyer actually takes the deliverable.
    //
    // This is the evidence behind the refund rule: cancel within 14 days ONLY
    // if you never downloaded. So the browser must not be able to write one
    // (a buyer could forge "no download" by never creating it — or worse,
    // create records for someone else), and must not be able to delete one to
    // erase proof of delivery. It also stays unreadable: it is our record for
    // settling disputes and paying contributors, not customer-facing data.
    //
    // Locked completely. Every legitimate write comes from the Cloud Function.
    match /downloads/{docId} {
      allow read:   if isAdmin();
      allow write:  if false;
    }

    // ── earnings (CONTRIBUTOR REVENUE SHARE, 9 Aug 2026) ──────────────────
    // One row per contributor line per paid order: gross, the real Whop fees,
    // net, and the 75% share. Written ONLY by the Cloud Function that reads
    // Whop's fee data — never by a browser, or a contributor could write
    // their own earnings. A contributor may read their own rows and nothing
    // else, which is what the earnings dashboard needs and no more.
    match /earnings/{docId} {
      allow read:  if isAdmin()
                   || (isSignedIn() && resource.data.contributorUid == request.auth.uid);
      allow write: if false;
    }

    // ── payouts (RECORD OF MONEY ACTUALLY SENT, 9 Aug 2026) ───────────────
    // Payouts are MANUAL — a human sends the money and records it here. Same
    // rule: a contributor sees their own history, only an admin can create it.
    match /payouts/{docId} {
      allow read:  if isAdmin()
                   || (isSignedIn() && resource.data.contributorUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── deployment_requests (WEB KIT DEPLOYMENT ENQUIRIES, 13 Aug 2026) ───
    // Someone wants us to build and host a web kit on their own domain. That
    // price is negotiated per client, so it never appears in the store — this
    // is just the enquiry that starts the conversation.
    //
    // WHY CREATE IS OPEN TO EVERYONE
    //   The person asking is usually not a customer yet and has no account.
    //   Requiring sign-in here would lose the enquiry. There is no money and
    //   no private data in this document, so an open create is the right call.
    //
    // WHY NOBODY CAN READ THEM BACK
    //   The documents hold a stranger's name, email and phone. If read were
    //   open, anyone could harvest every lead we have ever received. Only the
    //   two admin accounts may read, edit or delete.
    //
    // FIELD VALIDATION ON CREATE
    //   Caps the size so the collection cannot be used as free storage, and
    //   forces status to 'new' so a submitter cannot mark their own enquiry
    //   as quoted or closed.
    match /deployment_requests/{reqId} {
      allow read:   if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      allow create: if request.resource.data.status == 'new'
                    && request.resource.data.name  is string
                    && request.resource.data.name.size()  >= 2
                    && request.resource.data.name.size()  <= 80
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.email.matches('.+@.+[.].+')
                    && request.resource.data.needs is list
                    && request.resource.data.needs.size() >= 1
                    && request.resource.data.needs.size() <= 20
                    && request.resource.data.get('notes', '').size() <= 2000
                    && request.resource.data.keys().size() <= 14;
    }

    // ── design_orders (BACKGROUND DESIGN ORDERS, 2 Aug 2026) ──────────────
    // A buyer places an order and walks away; on_design_order builds it.
    // A signed-out visitor cannot create one at all — that is the whole
    // "no sign in, no generation" rule, enforced here rather than in the page,
    // so it holds even if someone calls Firestore directly.
    // The client may CREATE a queued order and READ its own orders. It may
    // never update or delete one: status, the finished file and the reject
    // reason are the server's words, not the buyer's.
    match /design_orders/{orderId} {
      allow read:   if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'queued'
                    && request.resource.data.slides is int
                    && request.resource.data.slides > 0
                    && (request.resource.data.slides <= 60 || isAdmin())
                    && request.resource.data.sentence is string
                    && request.resource.data.sentence.size() > 3
                    && request.resource.data.sentence.size() < 601;
      allow update, delete: if false;
    }

    // ── design_schedules (REPEATING DESIGNS — OWNER ONLY, 2 Aug 2026) ─────
    // A schedule is a standing claim on compute: it fires every day without
    // anyone clicking anything. So only the two owner accounts may have one.
    // A buyer places orders one at a time; the owner gets a routine.
    match /design_schedules/{scheduleId} {
      allow read:   if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.hour is int
                    && request.resource.data.hour >= 0
                    && request.resource.data.hour <= 23
                    && (!('minute' in request.resource.data) ||
                        (request.resource.data.minute is int
                         && request.resource.data.minute >= 0
                         && request.resource.data.minute <= 59))
                    && request.resource.data.slides is int
                    && request.resource.data.slides > 0
                    && request.resource.data.sentence is string
                    && request.resource.data.sentence.size() > 3
                    && request.resource.data.sentence.size() < 601;
      // pause / resume / retitle only — lastRunDate is the server's business,
      // and a client cannot rewrite it to make a schedule fire twice.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['active', 'hour', 'minute', 'slides', 'label']);
      allow delete: if isAdmin();
    }

    // ── kit_slots collection (PRIVATE) ────────────────────────────────────
    // The full per-slide capacity map. Read ONLY by the fit_content callable
    // via the Admin SDK (which bypasses these rules). Never readable by the
    // client — this keeps the matching/capacity logic off the browser.
    match /kit_slots/{kitId} {
      allow read:  if false;
      allow write: if false;
      // Admin cascade delete (29 Jul 2026) — same reasoning as /kits above.
      allow delete: if isAdmin();
    }

    // ── sellers collection ────────────────────────────────────────────────────
    // Each seller can read/write only their own profile doc.
    // NOTE (D7): payout fields are being REMOVED from this doc, not secured —
    // no freelancers yet. See F30.
    match /sellers/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── templates_internal collection ─────────────────────────────────────────
    // Private per-submission data (pdfMetaRaw). Was read/write for ANY signed-in
    // user — every seller could read every other seller's submission. Now scoped
    // to the owning seller, plus admins.
    // Requires `sellerId` on the document; upload_form.html now writes it.
    match /templates_internal/{docId} {
      allow read:   if isAdmin() || ownsDoc('sellerId');
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── editor_templates (free editable templates shown in the editor) ────
    // Public can READ (the editor's Templates panel reads this for everyone).
    // Only the admin account may WRITE (via the Template Upload page).
    match /editor_templates/{id} {
      allow read: if true;
      allow write: if isSignedIn() &&
                      request.auth.token.email in [
                        'javed5395@gmail.com',
                        'lazydogtemplates@gmail.com'
                      ];
    }

    // ════════════════════════════════════════════════════════════════════════
    // COMMERCE — every write is Admin SDK only (see KEY DESIGN NOTE above).
    // Clients read their own records and nothing else.
    // ════════════════════════════════════════════════════════════════════════

    // Buyer's own orders. Powers "My Purchases" and the download gate.
    match /orders/{orderId} {
      allow read:  if isAdmin() || ownsDoc('buyerId');
      allow write: if false;      // Whop webhook only (F06)
    }

    // Per-download record: buyer uid + email, kit id, timestamp, licence tier.
    // Feeds BOTH the 14-day refund check and per-item entitlement (D4/D6, F28).
    match /downloadLedger/{entryId} {
      allow read:  if isAdmin() || ownsDoc('buyerId');
      allow write: if false;      // server records every download (F28)
    }

    // Subscription state. The 5-free-slides gate and the deck-maker lock both
    // read from here once the Whop subscription plan exists (F34).
    // Doc id = the subscriber's uid.
    match /subscribers/{uid} {
      allow read:  if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;      // Whop subscription webhook only
    }

    // Seller-side accounting. Not buyer-facing — admin reads only.
    match /salesRecords/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /transactions/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /paymentJobs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // Append-only history. Nobody edits it, not even admins — the Admin SDK
    // writes it and it stays readable for investigation.
    match /auditTrail/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // payoutQueue — DELIBERATELY DENIED, not merely unwritten.
    // D7 (owner, 29 Jul 2026): seller payouts are being CUT, not repaired —
    // no freelancers yet. Do not "fix" this by opening it. When payouts are
    // rebuilt, give it the same Admin-SDK-only shape as the collections above.
    match /payoutQueue/{id} {
      allow read, write: if false;
    }

    // Chat/AI quota counters written by functions/main.py (Admin SDK).
    // Never client-visible — a client that can read its own counter can work
    // out exactly how much room it has left to abuse.
    match /chat_quota/{id} {
      allow read, write: if false;
    }

    // ── reviews (per-kit star ratings, 8 Aug 2026) ─────────────────────────
    // Public read so every visitor sees real ratings on kit pages. Any
    // signed-in visitor may write, but ONLY their own review, and the doc id
    // is forced to be `${kitId}_${uid}` — that is what makes "one review per
    // person per kit" actually true instead of a client-side promise; posting
    // again just overwrites their own doc, it can never create a second one.
    // createdAt must equal request.time so nobody can backdate a review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn()
                    && reviewId == (request.resource.data.kitId + '_' + request.auth.uid)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.kitId is string
                    && request.resource.data.kitId.size() > 0
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000
                    && request.resource.data.userName is string
                    && request.resource.data.userName.size() <= 80
                    && request.resource.data.createdAt == request.time;
      // A reviewer may remove their own review; admins may remove any
      // (moderation — e.g. abusive text).
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
