  function renderItems(){
    const cur=document.getElementById('currency')?.value||'$';
    const el=document.getElementById('itemsList'); if(!el)return;
    el.innerHTML='';
    items.forEach((item,i)=>{
      const t=((parseFloat(item.qty)||0)*(parseFloat(item.rate)||0)).toFixed(2);
      const row=document.createElement('div');
      row.className='item-row';
      row.style.gridTemplateColumns='2.5fr 1fr 1fr 1fr 28px';
      row.innerHTML=`<input type="text" placeholder="Description" value="${item.c1||''}" oninput="items[${i}].c1=this.value;liveUpdate()"/>
