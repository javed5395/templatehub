      el.appendChild(row);
    });
  }

  function getValues(){
    const cur=document.getElementById('currency')?.value||'$';
    const sub=items.reduce((s,it)=>s+(parseFloat(it.c2)||parseFloat(it.qty)||0)*(parseFloat(it.rate)||0),0);
    // For non-qty industries, use c2 as qty where numeric, else 1
    const realSub=items.reduce((s,it)=>{
      const q=parseFloat(it.c2)||1;
      const r=parseFloat(it.rate)||0;
      return s+q*r;
    },0);
    const tax=realSub*(parseFloat(document.getElementById('taxRate')?.value)||0)/100;
    const ft=getFromTo();
    return {cur,sub:realSub,tax,grand:realSub+tax,
      fromName:ft.from[0]||'Your Business',fromDetails:ft.from.slice(1).join(' | '),
      toName:ft.to[0]||'Client',toDetails:ft.to.slice(1).join(' | '),
